# Copy to .env (never commit .env) and fill in what you need.

# ---- AI report (at least one; without both you get an offline template) ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# REPORT_PROVIDER=auto        # auto | claude | gemini | template
# ANTHROPIC_MODEL=claude-haiku-4-5
# GEMINI_MODEL=gemini-3.5-flash

# ---- Email alerts (Gmail: turn on 2-Step Verification, then create an App password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO= himanshusinghsengar7999@gmail.com
# ALERT_EMAIL_FROM=Indux <you@gmail.com>
# ALERT_EMAIL_COOLDOWN_MIN=10     # same fault is emailed at most once per 10 minutes

# ---- Automatic alert handling ----
# AUTO_REPORT=1                   # write an AI report for every new fault/anomaly (0 = off)
# ALERT_REPORT_LANG=en            # en | hi
# RECORD_RAW=0                    # 1 = save every raw sensor window to data/recordings/ (~60-100 MB/hour)

